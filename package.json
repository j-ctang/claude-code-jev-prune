{
  "name": "claude-code-jev-prune",
  "version": "1.0.0",
  "description": "Local Claude Code HTTP proxy for pair-safe context pruning with TypeSafe Jev",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "check": "npm run lint && npm test && npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "claude-code",
    "http-proxy",
    "jev",
    "context-pruning",
    "tokens",
    "optimization",
    "anthropic"
  ],
  "author": "j-ctang",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "supertest": "^7.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j-ctang/claude-code-jev-prune"
  },
  "bugs": {
    "url": "https://github.com/j-ctang/claude-code-jev-prune/issues"
  },
  "homepage": "https://github.com/j-ctang/claude-code-jev-prune#readme"
}
