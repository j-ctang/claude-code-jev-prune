{
  "name": "claude-code-jev-prune",
  "version": "1.0.0",
  "description": "MCP plugin for Claude Code: intelligent context pruning with TypeSafe Jev",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "jev",
    "context-pruning",
    "tokens",
    "optimization",
    "anthropic"
  ],
  "author": "j-ctang",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "typesafe": "^1.0.0",
    "express": "^4.18.2",
    "node-cache": "^5.1.2",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j-ctang/claude-code-jev-prune"
  },
  "bugs": {
    "url": "https://github.com/j-ctang/claude-code-jev-prune/issues"
  },
  "homepage": "https://github.com/j-ctang/claude-code-jev-prune#readme"
}
